# ============================================================
#  Lorian Backend Server — 环境变量配置模板
#  复制此文件为 .env 并填入实际值
# ============================================================

# ---- 密钥（留空则自动生成随机值，每次重启会变）----
SECRET_KEY=
JWT_SECRET_KEY=

# ---- MySQL 数据库 ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lorian_backend

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- 安装包存储路径 ----
BINARY_FILES_PATH=

# ---- TalkingData 统计 ----
TALKINGDATA_APP_ID=
TALKINGDATA_ENABLED=false

# ============================================================
#  安全配置
# ============================================================

# 公开注册开关（生产环境建议设为 false）
#  false = 只能由管理员在 Dashboard 创建账号
#  true  = 允许任何人通过 POST /api/auth/register 注册（仅开发环境）
ALLOW_PUBLIC_REGISTER=true

# IP 白名单（逗号分隔，支持 CIDR，为空则不限制）
# 限制账号创建/删除等敏感操作只能从指定 IP 发起
# 示例: ADMIN_IP_WHITELIST=192.168.1.0/24,10.0.0.1
# localhost 始终豁免，无需加入
ADMIN_IP_WHITELIST=

# Admin 后门密钥（可选）
# 用于脚本/CI 场景，在 Header 中传入 X-Admin-Secret 可绕过 JWT
# 必须配合 IP 白名单使用，否则任何人拿到密钥都能操作
ADMIN_SECRET_KEY=
